# Database
DATABASE_URL=postgresql://eoh_user:eoh_password@localhost:5432/eoh_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://eoh_user:eoh_password@localhost:5672
RABBITMQ_EXCHANGE=eoh_exchange

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
SESSION_SECRET=your-session-secret-change-in-production

# OAuth (for SSO)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OKTA_DOMAIN=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=

# AI Services
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=eoh-knowledge-base

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@eoh.com

# Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=eoh-documents

# Monitoring
SENTRY_DSN=
DATADOG_API_KEY=

# Application
NODE_ENV=development
PORT=3000
API_PORT=4000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_DOCUMENT_PROCESSING=true
ENABLE_ANALYTICS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Encryption
ENCRYPTION_KEY=your-encryption-key-32-characters-long
